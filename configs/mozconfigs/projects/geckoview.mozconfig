# shellcheck shell=bash
# IronFox GeckoView mozconfig

set -euo pipefail

# Target GeckoView
ac_add_options --enable-ironfox-subproject='geckoview'

# Prevent running the `verifyGleanVersion` Gradle task and generating javadoc
export GRADLE_FLAGS="${GRADLE_FLAGS} -x javadocRelease -x verifyGleanVersion"

if [[ "${IRONFOX_MACH_TARGET_PROJECT}" == 'geckoview' ]]; then
  if [[ "${IRONFOX_MACH_GECKOVIEW_CREATE_AAR}" == 1 ]]; then
    # If we're building a GeckoView AAR, all we need to do is create the archive - so prevent re-running other build logic
    export GRADLE_FLAGS="${GRADLE_FLAGS} -x assembleRelease -x publishReleasePublicationToMavenRepository"
  fi
fi
