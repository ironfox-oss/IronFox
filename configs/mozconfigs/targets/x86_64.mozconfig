# shellcheck shell=bash
# x86_64

set -euo pipefail

ac_add_options --target='x86_64-linux-android'
ac_add_options --disable-android-bundle

# Enable performance optimizations
ac_add_options --enable-wasm-avx
ac_add_options --enable-wasm-relaxed-simd
ac_add_options --enable-wasm-simd

if [[ "${IRONFOX_MACH_BUILD}" == 1 ]]; then
  export RUSTDOCFLAGS="${RUSTDOCFLAGS} -Ctarget-feature=+avx"
  export RUSTFLAGS="${RUSTFLAGS} -Ctarget-feature=+avx"
fi
