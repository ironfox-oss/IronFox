# GitHub/Forgejo (linguist-language): Exact canonical case (Shell, JSON, JavaScript). UPPER or lower only do not work.
# GitLab (gitlab-language): lowercase only (shell, json).
#
# https://github.com/github-linguist/linguist/blob/main/lib/linguist/languages.yml
# https://github.com/go-enry/go-enry/blob/master/data/languageInfo.go

*.json                      linguist-detectable
*.yaml                      linguist-detectable
*.xml                       linguist-detectable
*.build                     linguist-language=PYTHON        gitlab-language=python
*.cfg                       linguist-language=JavaScript    gitlab-language=javascript
*.conf                      linguist-language=PYTHON        gitlab-language=python
*.configure                 linguist-language=PYTHON        gitlab-language=python
*.ftl                       linguist-language=INI           gitlab-language=ini
*.jsonc                     linguist-language=JSON          gitlab-language=json
*.mn                        linguist-language=MAKEFILE      gitlab-language=makefile
*.mozconfig                 linguist-language=Shell         gitlab-language=shell
*.properties                linguist-language=INI           gitlab-language=ini
*.yml                       linguist-language=YAML          gitlab-language=yaml
.git*                       linguist-language=Shell         gitlab-language=shell
.gitlab-ci.yml              linguist-language=YAML          gitlab-language=yaml
.npmrc*                     linguist-language=INI           gitlab-language=ini
machrc*                     linguist-language=INI           gitlab-language=ini
