         OnboardingCardType.MARKETING_DATA -> OnboardingPageUiData.Type.MARKETING_DATA
+        OnboardingCardType.IF_PREFERENCE_DOH -> OnboardingPageUiData.Type.IF_PREFERENCE_DOH
+        OnboardingCardType.IF_PREFERENCES -> OnboardingPageUiData.Type.IF_PREFERENCES
+        OnboardingCardType.IF_PREFERENCE_UPDATER -> OnboardingPageUiData.Type.IF_PREFERENCE_UPDATER
     }
 
 private fun List<CustomizationToolbarData>.toOnboardingToolbarOptions() = map { it.toOnboardingCustomizeToolbar() }
@@ -161,6 +171,41 @@ private fun ToolbarType.toToolbarOptionType() =
         ToolbarType.TOOLBAR_TOP -> ToolbarOptionType.TOOLBAR_TOP
         ToolbarType.TOOLBAR_BOTTOM -> ToolbarOptionType.TOOLBAR_BOTTOM
     }
+ 
+private fun List<IfPreferencesData>.toOnboardingIfPreferenceOptions() = map { it.toOnboardingIfPreferenceOption() }
+
+private fun IfPreferencesData.toOnboardingIfPreferenceOption() = with(this) {
+    IfPreferenceOption(
+        label = switchLabel,
+        caption = switchCaption,
+        description = switchDescription,
+        preferenceType = switchType.toIfPreferenceType(),
+    )
+}
+
+private fun IfOnboardingPreferenceType.toIfPreferenceType() = when (this) {
+    IfOnboardingPreferenceType.JS_JIT -> IfPreferenceType.JS_JIT
+    IfOnboardingPreferenceType.SAFE_BROWSING -> IfPreferenceType.SAFE_BROWSING
+    IfOnboardingPreferenceType.SPOOF_ENGLISH -> IfPreferenceType.SPOOF_ENGLISH
+    IfOnboardingPreferenceType.INSTALL_UBLOCK -> IfPreferenceType.INSTALL_UBLOCK
+    IfOnboardingPreferenceType.DEFAULT -> throw UnsupportedOperationException("Unsupported IfOnboardingPreferenceType: default")
+}
+
+private fun List<IfPreferenceUpdaterData>.toOnboardingIfPreferenceUpdaterOptions() = map { it.toOnboardingIfPreferenceUpdaterOption() }
+
+private fun IfPreferenceUpdaterData.toOnboardingIfPreferenceUpdaterOption() = with(this) {
+    IfPreferenceUpdaterOption(
+        label = switchLabel,
+        caption = switchCaption,
+        description = switchDescription,
+        preferenceType = switchType.toIfPreferenceUpdaterType(),
+    )
+}
+
+private fun IfOnboardingPreferenceUpdaterType.toIfPreferenceUpdaterType() = when (this) {
+    IfOnboardingPreferenceUpdaterType.UPDATER -> IfPreferenceUpdaterType.UPDATER
+    IfOnboardingPreferenceUpdaterType.DEFAULT -> throw UnsupportedOperationException("Unsupported IfOnboardingPreferenceUpdaterType: default")
+}
 
