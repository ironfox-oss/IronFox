From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Tue, 10 Mar 2026 01:00:42 +0000
Subject: [PATCH] Fenix - IronFox onboarding

Adds IronFox-specific onboarding screens.

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/mobile/android/fenix/app/onboarding.fml.yaml b/mobile/android/fenix/app/onboarding.fml.yaml
index 73b46a4a7e60..a251d9db6d37 100644
--- a/mobile/android/fenix/app/onboarding.fml.yaml
+++ b/mobile/android/fenix/app/onboarding.fml.yaml
@@ -58,6 +58,57 @@ features:
                   body-line-one-text: nova_onboarding_marketing_body
                   body-line-one-link-text: nova_onboarding_marketing_body_link_text
 
+            if-preference-doh:
+              card-type: if-preference-doh
+              enabled: true
+              title: ironfox_onboarding_preferences_title
+              body: ironfox_onboarding_doh_caption
+              image-res: ic_launcher_foreground
+              ordering: 10000
+              primary-button-label: nova_onboarding_continue_button
+
+            if-preferences:
+              card-type: if-preferences
+              enabled: true
+              title: ironfox_onboarding_preferences_title
+              body: ironfox_onboarding_preferences_description
+              image-res: ic_launcher_foreground
+              ordering: 10005
+              primary-button-label: nova_onboarding_continue_button
+              extra-data:
+                if-preferences-data:
+                  - switch-type: js-jit
+                    switch-label: ironfox_onboarding_jit_enabled
+                    switch-caption: ironfox_onboarding_jit_enabled_caption
+                    switch-description: ironfox_onboarding_jit_enabled_description
+                  - switch-type: safe-browsing
+                    switch-label: ironfox_onboarding_safe_browsing_enabled
+                    switch-caption: ironfox_onboarding_safe_browsing_enabled_caption
+                    switch-description: ironfox_onboarding_safe_browsing_enabled_description
+                  - switch-type: spoof-english
+                    switch-label: ironfox_onboarding_spoof_english
+                    switch-caption: ironfox_onboarding_spoof_english_caption
+                    switch-description: ironfox_onboarding_spoof_english_description
+                  - switch-type: install-ublock
+                    switch-label: ironfox_onboarding_install_ublock
+                    switch-caption: ironfox_onboarding_install_ublock_caption
+                    switch-description: ironfox_onboarding_install_ublock_description
+
+            if-preference-updater:
+              card-type: if-preference-updater
+              enabled: true
+              title: ironfox_onboarding_preferences_title
+              body: ironfox_onboarding_preferences_description
+              image-res: ic_launcher_foreground
+              ordering: 10010
+              primary-button-label: nova_onboarding_continue_button
+              extra-data:
+                if-preference-updater-data:
+                  - switch-type: updater
+                    switch-label: ironfox_onboarding_updater_switch
+                    switch-caption: ironfox_onboarding_updater_title
+                    switch-description: ironfox_onboarding_updater_description
+
   continuous-onboarding:
     description: >
       Feature to enable the continuous onboarding flow. This feature reduces the number of upfront
@@ -148,6 +199,16 @@ objects:
         description: >
           An optional marketing data for the onboarding card.
         default: null
+      if-preferences-data:
+        type: List<IfPreferencesData>
+        description: >
+          A list of preferences for the IronFox preferences onboarding card.
+        default: [ ]
+      if-preference-updater-data:
+        type: List<IfPreferenceUpdaterData>
+        description: >
+          A list of preferences for the IronFox updater preferences onboarding card.
+        default: [ ]
 
   CustomizationToolbarData:
     description: An object to describe the placement of the toolbar.
@@ -248,6 +309,46 @@ objects:
         description: The text for line three of the body.
         default: ""
 
+  IfPreferencesData:
+    description: An object to describe the IronFox preferences onboarding card.
+    fields:
+      switch-label:
+        type: Text
+        description: The text for the preference switch.
+        default: ""
+      switch-caption:
+        type: Text
+        description: The text for the brief caption of the switch.
+        default: ""
+      switch-description:
+        type: Text
+        description: The text for the long description of the switch.
+        default: ""
+      switch-type:
+        type: IfOnboardingPreferenceType
+        description: The type of preference.
+        default: default
+
+  IfPreferenceUpdaterData:
+    description: An object to describe the IronFox updater preferences onboarding card.
+    fields:
+      switch-label:
+        type: Text
+        description: The text for the preference switch.
+        default: ""
+      switch-caption:
+        type: Text
+        description: The text for the brief caption of the switch.
+        default: ""
+      switch-description:
+        type: Text
+        description: The text for the long description of the switch.
+        default: ""
+      switch-type:
+        type: IfOnboardingPreferenceUpdaterType
+        description: The type of preference.
+        default: default
+
 enums:
 
   OnboardingCardType:
@@ -267,6 +368,34 @@ enums:
         description: Page to display the terms of services.
       marketing-data:
         description: Allows user to opt out of marketing data collection.
+      if-preference-doh:
+        description: Allows user to configure DNS-over-HTTPS.
+      if-preferences:
+        description: Allows user to configure IronFox-specific preferences.
+      if-preference-updater:
+        description: Allows user to configure the built-in app updater.
+
+  IfOnboardingPreferenceType:
+    description: An enum to describe an IronFox preference option.
+    variants:
+      default:
+        description: Default value for preference type. NEVER use this.
+      js-jit:
+        description: Whether to enable JavaScript JIT.
+      safe-browsing:
+        description: Whether to enable safe browsing.
+      spoof-english:
+        description: Whether to request English versions of web pages for enhanced privacy.
+      install-ublock:
+        description: Whether to install uBlock Origin.
+
+  IfOnboardingPreferenceUpdaterType:
+    description: An enum to describe an IronFox updater preference option.
+    variants:
+      default:
+        description: Default value for preference type. NEVER use this.
+      updater:
+        description: Whether to check for IronFox updates automatically.
 
   ToolbarType:
     description: An enum to describe a toolbar placement option.
