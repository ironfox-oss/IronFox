         OnboardingPageUiData.Type.DEFAULT_BROWSER ->
@@ -237,6 +285,30 @@ internal fun mapToOnboardingPageState(
                 onNegativeButtonClick = {}, // No negative button option for marketing data.
                 isSmallDevice = isSmallDevice,
