  <string name="updater_dialog_title">Update available</string>
  <string name="updater_dialog_message">IronFox %1$s is available.</string>
  <string name="updater_dialog_store_message">IronFox %1$s is available. Open %2$s to update it; if it is not listed there yet, refresh the store.</string>
  <string name="updater_dialog_ready_message">IronFox %1$s has been downloaded and is ready to install.</string>
  <string name="updater_dialog_install">Install</string>
  <string name="updater_dialog_update">Update</string>
  <string name="updater_dialog_open_store">Open %1$s</string>
  <string name="updater_dialog_later">Later</string>
  <string name="updater_dialog_release_notes">Release notes</string>

  <!-- Store no longer installed -->
  <string name="updater_store_gone_title">%1$s is not available</string>
  <string name="updater_store_gone_message">IronFox was installed from %1$s, but it is no longer installed. Download and install the update directly?</string>
  <string name="updater_store_gone_download">Download</string>

  <!-- Install permission -->
  <string name="updater_unknown_sources_title">Allow installing updates</string>
  <string name="updater_unknown_sources_message">Android needs your permission before IronFox can install updates. Allow it on the next screen, then come back here.</string>
  <string name="updater_unknown_sources_continue">Continue</string>

