  <string name="updater_check_now_title">Check for updates</string>
  <string name="updater_status_never">Not checked yet</string>
  <string name="updater_status_last_checked">Last checked %1$s</string>
  <string name="updater_status_available">Version %1$s is available. Tap to update.</string>
  <string name="updater_status_checking">Checking...</string>
  <string name="updater_status_downloading">Downloading the update...</string>
  <string name="updater_status_error">Could not check for updates: %1$s</string>

