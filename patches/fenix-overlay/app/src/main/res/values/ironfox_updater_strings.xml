<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Updates settings -->
  <string name="updater_title">Updates</string>
  <string name="updater_enabled_title">Check for updates automatically</string>
  <string name="updater_enabled_summary">IronFox checks the IronFox release server for new versions and asks before installing them.</string>
  <string name="updater_interval_title">Check interval</string>
  <string name="updater_interval_summary">How often IronFox checks for updates, in hours</string>
  <string name="updater_direct_downloads_title">Download updates directly</string>
  <string name="updater_direct_downloads_summary">Download and install updates with IronFox instead of opening %1$s. Android may ask you to confirm updating from a different source.</string>
  <string name="updater_auto_download_title">Download updates automatically</string>
  <string name="updater_auto_download_summary">When an update is found, IronFox downloads it right away on any connection, including mobile data. Updates are up to about 200 MB.</string>
  <string name="updater_auto_download_needs_direct_summary">Turn on "Download updates directly" first.</string>
  <string name="updater_auto_download_confirm_title">Download updates automatically?</string>
  <string name="updater_auto_download_confirm_message">When an update is found, IronFox will download it right away on any connection, including mobile data. Updates are up to about 200 MB. You still choose when to install.</string>
  <string name="updater_auto_download_confirm_enable">Turn on</string>
  <string name="updater_insecure_http_title">Allow insecure HTTP connections</string>
  <string name="updater_insecure_http_summary">Lets the updater use plain HTTP. Only for testing against a local update server.</string>
  <string name="updater_insecure_http_blocked_summary">HTTPS-Only mode blocks plain HTTP. Turn it off for all tabs in Privacy and security to use this.</string>
  <string name="updater_source_title">Updates through</string>
  <string name="updater_source_direct">IronFox (direct download)</string>
