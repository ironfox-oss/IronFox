From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Tue, 29 Sep 2026 07:31:44 +0000
Subject: [PATCH] Fenix - Remove Firefox VPN promotion

Removes Mozilla's promotional "Try it free" nag to enable Firefox VPN in the browser's settings.

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt
index bb16e91996..46bb5b72ea 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt
@@ -147,7 +147,7 @@ private fun badgeText(status: IPProtectionStatus): String =
         IPProtectionStatus.Activating -> stringResource(R.string.ip_protection_menu_connecting)
         IPProtectionStatus.DataLimitReached -> stringResource(R.string.ip_protection_menu_paused)
         IPProtectionStatus.ConnectionError -> stringResource(R.string.ip_protection_menu_error)
-        IPProtectionStatus.AuthRequired -> stringResource(R.string.ip_protection_menu_try_vpn_cta)
+        IPProtectionStatus.AuthRequired -> stringResource(R.string.preferences_ip_protection_off)
     }
 
 private fun badgeState(status: IPProtectionStatus): MenuItemState =
-- 
