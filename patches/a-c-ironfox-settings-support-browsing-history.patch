From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Sun, 04 Oct 2026 19:07:03 +0000
Subject: [PATCH] Android Components - IronFox Settings: Browsing history

Provides support for a UI setting to enable/disable browsing history.

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/mobile/android/android-components/components/feature/recentlyclosed/src/main/java/mozilla/components/feature/recentlyclosed/RecentlyClosedMiddleware.kt b/mobile/android/android-components/components/feature/recentlyclosed/src/main/java/mozilla/components/feature/recentlyclosed/RecentlyClosedMiddleware.kt
index b8defe21b4cd..b6f10b986a80 100644
--- a/mobile/android/android-components/components/feature/recentlyclosed/src/main/java/mozilla/components/feature/recentlyclosed/RecentlyClosedMiddleware.kt
+++ b/mobile/android/android-components/components/feature/recentlyclosed/src/main/java/mozilla/components/feature/recentlyclosed/RecentlyClosedMiddleware.kt
@@ -26,6 +26,7 @@ import mozilla.components.lib.state.Store
 class RecentlyClosedMiddleware(
     private val storage: Lazy<Storage>,
     private val maxSavedTabs: Int,
+    private val historyEnabled: Boolean,
     private val scope: CoroutineScope = CoroutineScope(Dispatchers.IO),
 ) : Middleware<BrowserState, BrowserAction> {
 
@@ -36,7 +37,7 @@ class RecentlyClosedMiddleware(
     ) {
         when (action) {
             is UndoAction.ClearRecoverableTabs -> {
-                if (action.tag == store.state.undoHistory.tag) {
+                if (historyEnabled && action.tag == store.state.undoHistory.tag) {
                     // If the user has removed tabs and not invoked "undo" then let's save all non
                     // private tabs.
                     store.dispatch(
@@ -47,7 +48,7 @@ class RecentlyClosedMiddleware(
                 }
             }
             is UndoAction.AddRecoverableTabs -> {
-                if (store.state.undoHistory.tabs.isNotEmpty()) {
+                if (historyEnabled && store.state.undoHistory.tabs.isNotEmpty()) {
                     // If new tabs get added to the undo history and there were some previously
                     // then add them to the list of closed tabs now since they will never go through
                     // the clear call above.
@@ -93,10 +94,12 @@ class RecentlyClosedMiddleware(
     }
 
     private fun addTabsToStorage(tabList: List<RecoverableTab>) = scope.launch {
-        storage.value.addTabsToCollectionWithMax(
-            tabList,
-            maxSavedTabs,
-        )
+        if (historyEnabled) {
+            storage.value.addTabsToCollectionWithMax(
+                tabList,
+                maxSavedTabs,
+            )
+        }
     }
 
     private fun removeTab(action: RecentlyClosedAction.RemoveClosedTabAction) = scope.launch {
-- 
