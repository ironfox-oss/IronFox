     private val recentSyncedTabFeature = ViewBoundFeatureWrapper<RecentSyncedTabFeature>()
     private val bookmarksFeature = ViewBoundFeatureWrapper<BookmarksFeature>()
@@ -572,6 +575,7 @@ class HomeFragment : Fragment(), UserInteractionHandler, OnLongPressedListener {
         initSnackbarBinding(view = view)
         initIpProtectionBindings(view = view)
         initContinuousOnboardingFeature()
+        initIFMessageFeature()
 
         privacyNoticeBannerStore =
             PrivacyNoticeBannerStore(
@@ -1512,6 +1516,20 @@ class HomeFragment : Fragment(), UserInteractionHandler, OnLongPressedListener {
         )
     }
 
+    private fun initIFMessageFeature() {
+        IFMessageFeature.register(
+            fragment = this,
+            binding = ifMessageFeature,
+            navigateToDohSettings = {
+                findNavController()
+                    .navigateSafe(
+                        R.id.homeFragment,
+                        HomeFragmentDirections.actionHomeFragmentToDohSettingsFragment(),
+                    )
+            },
