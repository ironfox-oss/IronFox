From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Fri, 16 Oct 2026 05:51:38 +0000
Subject: [PATCH] Fenix - IronFox messaging

Provides support for displaying in-app messages/pop-ups to users.

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
index 2d733a28d4d3..e34da3dc3383 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt
@@ -88,10 +88,12 @@ import org.mozilla.fenix.settings.downloads.DownloadLocationManager
 import org.mozilla.fenix.summarization.SummarizationNavigator
 import org.mozilla.fenix.termsofuse.store.Surface
 import org.mozilla.fenix.utils.Settings
+import org.ironfoxoss.ironfox.utils.IFMessageFeature
 
 /** Fragment used for browsing the web within the main app. */
 @Suppress("TooManyFunctions", "LargeClass")
 class BrowserFragment : BaseBrowserFragment(), UserInteractionHandler, SystemInsetsPaddedFragment {
+    private val ifMessageFeature = ViewBoundFeatureWrapper<IFMessageFeature>()
     private val windowFeature = ViewBoundFeatureWrapper<WindowFeature>()
     private val openInAppOnboardingObserver = ViewBoundFeatureWrapper<OpenInAppOnboardingObserver>()
     private val translationsBinding = ViewBoundFeatureWrapper<TranslationsBinding>()
@@ -170,6 +172,7 @@ class BrowserFragment : BaseBrowserFragment(), UserInteractionHandler, SystemIns
         initPdfTools(context = context, rootView = view)
         initListenSheet(context = context, rootView = view)
         initContinuousOnboardingFeature()
+        initIFMessageFeature()
 
         thumbnailsFeature.set(
             feature = BrowserThumbnails(context, binding.engineView, components.core.store),
@@ -403,6 +406,20 @@ class BrowserFragment : BaseBrowserFragment(), UserInteractionHandler, SystemIns
         )
     }
 
+    private fun initIFMessageFeature() {
+        IFMessageFeature.register(
+            fragment = this,
+            binding = ifMessageFeature,
+            navigateToDohSettings = {
+                findNavController()
+                    .navigateSafe(
+                        R.id.browserFragment,
+                        BrowserFragmentDirections.actionBrowserFragmentToDohSettingsFragment(),
+                    )
+            },
+        )
+    }
+
     private fun openTranslationsDialogFromToolbar() {
         Translations.action.record(Translations.ActionExtra("main_flow_toolbar"))
         requireComponents.appStore.dispatch(SnackbarAction.SnackbarDismissed)
