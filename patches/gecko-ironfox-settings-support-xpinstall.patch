From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Sun, 05 Jul 2026 05:20:13 +0000
Subject: [PATCH] Gecko - IronFox Settings: XPInstall

Provides support for a UI setting to enable/disable the installation of add-ons.

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/browser/components/enterprisepolicies/Policies.sys.mjs b/browser/components/enterprisepolicies/Policies.sys.mjs
index c5559ce3f32a..7eae91691069 100644
--- a/browser/components/enterprisepolicies/Policies.sys.mjs
+++ b/browser/components/enterprisepolicies/Policies.sys.mjs
@@ -29,6 +29,7 @@ ChromeUtils.defineESModuleGetters(lazy, {
   SearchService: "moz-src:///toolkit/components/search/SearchService.sys.mjs",
   QuickSuggest: "moz-src:///browser/components/urlbar/QuickSuggest.sys.mjs",
   WebsiteFilter: "resource:///modules/policies/WebsiteFilter.sys.mjs",
+  IFPrefUtils:   "moz-src:///ironfox/utils/IFPrefUtils.sys.mjs",
 
   PoliciesUtils: "resource://gre/modules/PoliciesHelpers.sys.mjs",
   addAllowDenyPermissions: "resource://gre/modules/PoliciesHelpers.sys.mjs",
@@ -2218,8 +2219,8 @@ export var Policies = {
         lazy.addAllowDenyPermissions("install", param.Allow, null);
       }
       if ("Default" in param) {
-        lazy.PoliciesUtils.setAndLockPref("xpinstall.enabled", param.Default);
-        if (!param.Default) {
+//        lazy.PoliciesUtils.setAndLockPref("xpinstall.enabled", param.Default);
+        if (!lazy.IFPrefUtils.getBoolPref("xpinstall.enabled")) {
           manager.disallowFeature("installTemporaryAddon");
           lazy.PoliciesUtils.setAndLockPref(
             "browser.newtabpage.activity-stream.asrouter.userprefs.cfr.addons",
-- 
