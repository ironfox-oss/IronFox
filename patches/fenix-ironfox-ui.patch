--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/Page.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/Page.kt
@@ -25,12 +25,12 @@ enum class Page {
          *
          * @param shouldShowTabGroupsPage Whether the tab groups page should be included.
          */
-        fun visiblePages(shouldShowTabGroupsPage: Boolean): List<Page> =
+        fun visiblePages(shouldShowTabGroupsPage: Boolean, showFxa: Boolean, showNormalTabs: Boolean): List<Page> =
             listOfNotNull(
                 PrivateTabs,
-                NormalTabs,
+                NormalTabs.takeIf { showNormalTabs },
                 TabGroups.takeIf { shouldShowTabGroupsPage },
-                SyncedTabs,
+                SyncedTabs.takeIf { showFxa },
             )
 
         /**
@@ -39,12 +39,13 @@ enum class Page {
          * @param position The index of the page.
          * @param shouldShowTabGroupsPage Whether the tab groups page should be included.
          */
-        fun positionToPage(position: Int, shouldShowTabGroupsPage: Boolean = false): Page {
+        fun positionToPage(position: Int, shouldShowTabGroupsPage: Boolean = false, showFxa: Boolean = false, showNormalTabs: Boolean = true): Page {
             return when {
                 position == 0 -> PrivateTabs
-                position == 1 -> NormalTabs
+                showNormalTabs && position == 1 -> NormalTabs
                 shouldShowTabGroupsPage && position == 2 -> TabGroups
-                else -> SyncedTabs
+                showFxa && position == 3 -> SyncedTabs
+                else -> PrivateTabs
             }
         }
 
@@ -54,12 +55,12 @@ enum class Page {
          * @param page The [Page] whose visual index is being looked-up.
          * @param shouldShowTabGroupsPage Whether the tab groups page should be included.
          */
-        fun pageToPosition(page: Page, shouldShowTabGroupsPage: Boolean = false): Int {
+        fun pageToPosition(page: Page, shouldShowTabGroupsPage: Boolean = false, showFxa: Boolean = false, showNormalTabs: Boolean = true): Int {
             return when (page) {
                 PrivateTabs -> 0
-                NormalTabs -> 1
-                TabGroups -> if (shouldShowTabGroupsPage) 2 else 1
-                SyncedTabs -> visiblePages(shouldShowTabGroupsPage).lastIndex
+                NormalTabs -> if (showNormalTabs) 1 else 0
+                TabGroups -> if (shouldShowTabGroupsPage) 2 else if (showNormalTabs) 1 else 0
+                SyncedTabs -> if (showFxa) visiblePages(shouldShowTabGroupsPage, showFxa, showNormalTabs).lastIndex else if (shouldShowTabGroupsPage) 2 else if (showNormalTabs) 1 else 0
             }
         }
     }
