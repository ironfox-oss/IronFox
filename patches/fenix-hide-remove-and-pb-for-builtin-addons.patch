From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: celenity <celenity@celenity.dev>
Date: Sun, 05 Jul 2026 20:19:20 +0000
Subject: [PATCH] Fenix - Hide the 'Remove' and 'Run in private browsing' toggles for built-in add-ons

Signed-off-by: celenity <celenity@celenity.dev>
---
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt
index 1ac4e1998307..cfd890682313 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/InstalledAddonDetailsFragment.kt
@@ -38,6 +38,7 @@ import org.mozilla.fenix.e2e.SystemInsetsPaddedFragment
 import org.mozilla.fenix.ext.components
 import org.mozilla.fenix.ext.runIfFragmentIsAttached
 import org.mozilla.fenix.ext.showToolbar
+import org.ironfoxoss.ironfox.utils.IronFoxAddons
 
 /** An activity to show the details of a installed add-on. */
 @Suppress("LargeClass", "TooManyFunctions")
@@ -157,6 +158,10 @@ class InstalledAddonDetailsFragment : Fragment(), SystemInsetsPaddedFragment {
         bindAllowInPrivateBrowsingSwitch()
         bindRemoveButton()
         bindReportButton()
+        if (IronFoxAddons.isBuiltIn(addon)) {
+            providePrivateBrowsingSwitch().isVisible = false
+            binding.removeAddOn.isVisible = false
+        }
         context?.let {
             val messageBarWarningView = binding.root.findViewById<View>(addonsR.id.add_on_messagebar_warning)
             val messageBarErrorView = binding.root.findViewById<View>(addonsR.id.add_on_messagebar_error)
-- 
